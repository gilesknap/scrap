#!/bin/sh
# Delete the stored files nothing uses any more (`scrap gc --delete`), in a
# throwaway container, but only after a backup in the last 26 hours (a run
# directory holding the COMPLETE marker `scrap backup` writes once the copy has
# passed an integrity check; a partial run does not count): every file
# a backup's database names is in that backup, so deleting the live copy never
# loses the only one. Files younger than 24 hours are kept (uploads in flight).
# Started by scrap-gc.timer, after the nightly backup.
# Pages in the trash longer than SCRAP_TRASH_DAYS (default 30; off: never) are purged.
# It is read only from scrap's own ~/.config/scrap/ingest.env (its last
# SCRAP_TRASH_DAYS= line), the file the server reads, never from this script's
# environment, so gc and the purge dates the PWA shows cannot disagree.
# Settings come from the environment (~/.config/scrap/env via systemd). Arguments
# are passed on to `scrap gc` after its defaults, so the last wins: --grace-hours 48,
# --run-days 60, --job-days 14, or --dry-run to only count (a drop-in on
# scrap-gc.service that replaces ExecStart; see docs/reference/scheduled-jobs.md).
# Installed by install.sh to ~/.local/lib/scrap/.
set -eu

# SCRAP_VOLUME_OPTS: the options after the colon on every --volume (SELinux
# relabelling); z (shared label) unless the env file sets it, empty for none.
# Lowercase: an uppercase Z makes the label private to one container and locks
# the backup and gc containers out of SCRAP_DATA.
volume_opts=${SCRAP_VOLUME_OPTS-z}
case $volume_opts in
*[!A-Za-z,]*)
    echo "SCRAP_VOLUME_OPTS must be letters and commas (e.g. z), not '$volume_opts'" >&2
    exit 1
    ;;
esac
[ -z "$volume_opts" ] || volume_opts=":$volume_opts"
# The path the units use (/usr/bin/podman), not whatever PATH finds first, so
# a script run by hand does what the unit does. PODMAN is a test hook, not a setting.
podman=${PODMAN:-/usr/bin/podman}

: "${SCRAP_BACKUPS:?SCRAP_BACKUPS is not set}"
: "${SCRAP_DATA:?SCRAP_DATA is not set}"
: "${SCRAP_IMAGE:?SCRAP_IMAGE is not set}"
trash_days=
if [ -r "$HOME/.config/scrap/ingest.env" ]; then
    trash_days=$(sed -n 's/^SCRAP_TRASH_DAYS=[[:space:]]*//p' "$HOME/.config/scrap/ingest.env" |
        tail -n 1 | tr -d '[:space:]')
fi
if [ -n "$trash_days" ]; then
    set -- --trash-days "$trash_days" "$@"
fi
exec 9>"$SCRAP_BACKUPS/.lock" # never during a backup run
flock 9
recent=$(find -H "$SCRAP_BACKUPS" -mindepth 2 -maxdepth 2 -type f -name COMPLETE -mmin -1560 \
    -path '*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z/COMPLETE' |
    head -n 1)
mode=--delete
if [ -z "$recent" ]; then
    echo "No backup in the last 26 hours: counting only, deleting nothing." >&2
    mode=--dry-run
fi
"$podman" run --rm --replace --name scrap-gc \
    --userns=keep-id:uid=10001,gid=10001 --network=none \
    --volume "$SCRAP_DATA:/data$volume_opts" --env SCRAP_DATA_DIR=/data \
    "$SCRAP_IMAGE" gc "$mode" --grace-hours 24 "$@"
[ -n "$recent" ] || exit 1
