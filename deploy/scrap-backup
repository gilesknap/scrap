#!/bin/sh
# Back up scrap, then keep only the newest SCRAP_BACKUP_KEEP runs.
#   scrap-backup          one backup run (what scrap-backup.service runs)
#   scrap-backup prune    retention only
# Settings come from the environment (~/.config/scrap/env via systemd).
# Installed by install.sh to ~/.local/lib/scrap/.
set -eu

: "${SCRAP_BACKUPS:?SCRAP_BACKUPS is not set}"
case "${SCRAP_BACKUP_KEEP:-}" in
'' | *[!0-9]* | 0 | 0*)
    echo "SCRAP_BACKUP_KEEP must be a whole number >= 1, got '${SCRAP_BACKUP_KEEP:-}'" >&2
    exit 1
    ;;
esac

# SCRAP_VOLUME_OPTS: the options after the colon on every --volume (SELinux
# relabelling); z (shared label) unless the env file sets it, empty for none.
# Lowercase: an uppercase Z makes the label private to one container and locks
# the backup and gc containers out of SCRAP_DATA.
volume_opts=${SCRAP_VOLUME_OPTS-z}
case $volume_opts in
*[!A-Za-z,]*)
    echo "SCRAP_VOLUME_OPTS must be letters and commas (e.g. z), not '$volume_opts'" >&2
    exit 1
    ;;
esac
[ -z "$volume_opts" ] || volume_opts=":$volume_opts"
# The path the units use (/usr/bin/podman), not whatever PATH finds first, so
# a script run by hand does what the unit does. PODMAN is a test hook, not a setting.
podman=${PODMAN:-/usr/bin/podman}

# Delete all but the newest SCRAP_BACKUP_KEEP backup runs. Only real
# directories directly in SCRAP_BACKUPS named like a run (20261019T033000Z)
# are candidates: symlinks and anything else are never touched.
prune() {
    find "$SCRAP_BACKUPS" -mindepth 1 -maxdepth 1 -type d \
        -name '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z' \
        -print0 |
        sort -z | head -z -n -"$SCRAP_BACKUP_KEEP" | xargs -0r rm -rf --
}

if [ "${1:-}" = prune ]; then
    prune
    exit 0
fi

: "${SCRAP_DATA:?SCRAP_DATA is not set}"
: "${SCRAP_IMAGE:?SCRAP_IMAGE is not set}"
# Never at the same time as scrap-gc: a file it deletes mid-backup could be one
# the backup's database still names.
exec 9>"$SCRAP_BACKUPS/.lock"
flock 9
dest=$(date -u +%Y%m%dT%H%M%SZ)
# No -p: a run that already exists (two runs in one second) must fail here,
# before the cleanup below could delete the other run's backup.
mkdir "$SCRAP_BACKUPS/$dest"
if ! "$podman" run --rm --replace --name scrap-backup \
    --userns=keep-id:uid=10001,gid=10001 --network=none \
    --volume "$SCRAP_DATA:/data$volume_opts" \
    --volume "$SCRAP_BACKUPS:/backups$volume_opts" \
    --env SCRAP_DATA_DIR=/data \
    "$SCRAP_IMAGE" backup "/backups/$dest"; then
    rm -rf -- "${SCRAP_BACKUPS:?}/$dest"
    echo "Backup failed; kept the existing backups untouched." >&2
    exit 1
fi
prune
