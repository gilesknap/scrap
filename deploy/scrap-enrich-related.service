# Pick related pages for every page changed since its last picks (`scrap enrich
# --related`), in the running scrap container, which holds the Claude key and settings.
# It stops at an ingest queue pause and keeps to the same daily budget
# (SCRAP_BUDGET_DAY_USD); it fails only when it stops there. While ingest or
# enrich is off, or no API key is set, it says so and succeeds. Started by
# scrap-enrich-related.timer; installed and enabled by install.sh.
[Unit]
Description=scrap related pages (nightly)
After=scrap.service scrap-backup.service
Requisite=scrap.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec scrap scrap enrich --related
