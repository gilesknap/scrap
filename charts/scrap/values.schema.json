{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Unknown keys are rejected, so a mistyped key (or an API key passed as a value) fails instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "maxUploadMB": {"type": "number", "exclusiveMinimum": 0},
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "apiKeyKey": {"type": "string", "minLength": 1},
        "notifyUrlKey": {"type": "string"},
        "visionModel": {"type": "string"},
        "budgetDayUSD": {"type": ["string", "number"], "minimum": 0, "pattern": "^([0-9]+(\\.[0-9]+)?)?$"}
      }
    },
    "identityHeader": {"type": "string", "pattern": "^[A-Za-z0-9-]*$"},
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "extraEnv": {"type": "array"},
    "extraEnvFrom": {"type": "array"},
    "persistence": {"$ref": "#/definitions/claim"},
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "keep": {"type": "integer", "minimum": 1},
        "monthly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "schedule": {"type": "string", "minLength": 1},
            "timeZone": {"type": "string"},
            "keep": {"type": "integer", "minimum": 1}
          }
        },
        "persistence": {"$ref": "#/definitions/claim"},
        "resources": {"type": "object"}
      }
    },
    "gc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "delete": {"type": "boolean"},
        "graceHours": {"type": "number", "minimum": 0},
        "runDays": {"type": "number", "minimum": 1, "maximum": 36500},
        "trashDays": {"type": "number", "minimum": 1, "maximum": 36500},
        "jobDays": {"type": "number", "minimum": 1, "maximum": 36500},
        "requireBackup": {"type": "boolean"},
        "resources": {"type": "object"}
      }
    },
    "enrichRelated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "resources": {"type": "object"}
      }
    },
    "enrichTopics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "resources": {"type": "object"}
      }
    },
    "service": {"type": "object"},
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"type": "string"}},
        "tls": {"type": "array"}
      }
    },
    "networkPolicy": {"type": "object"},
    "public": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
        "createNamespace": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "site": {"type": "string", "pattern": "^(https?://[^/?#\\s]+/?)?$"},
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "indexing": {"type": "boolean"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "annotations": {"type": "object"},
            "hosts": {"type": "array", "items": {"type": "string"}},
            "tls": {"type": "array"}
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "webFrom": {"type": "array"}
          }
        },
        "sizeLimit": {"type": "string", "minLength": 1},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": {"type": "object"},
            "receiver": {"type": "object"}
          }
        }
      }
    },
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1},
        "size": {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
