   "CREATE TABLE page_rev ( page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, rev INTEGER NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, author TEXT NOT NULL, created_at TEXT NOT NULL, source TEXT NOT NULL DEFAULT 'web' CHECK (source IN ('web', 'mcp')), PRIMARY KEY (page_id, rev) )"
  ],
  "page_todo": [
   "table",
