# scrap as a rootless podman container, run by systemd for one unix user.
# Unit settings come from ~/.config/scrap/env; scrap's own settings (ingest,
# the API key, the notify URL) from ~/.config/scrap/ingest.env, which podman
# passes into the container. See install.sh. Installed by deploy/install.sh
# into ~/.config/systemd/user/.
[Unit]
Description=scrap personal knowledge store
Documentation=https://gilesknap.github.io/scrap/
RequiresMountsFor=%t/containers
# Give up after 5 failed starts in 5 minutes (e.g. the image is missing).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
EnvironmentFile=%h/.config/scrap/env
Environment=PODMAN_SYSTEMD_UNIT=%n
# SCRAP_LISTEN picks a Unix socket in %t/scrap (the runtime folder below) or
# a port on 127.0.0.1: see scrap-run.
RuntimeDirectory=scrap
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/mkdir -p ${SCRAP_DATA}
ExecStart=%h/.local/lib/scrap/scrap-run
ExecStop=/usr/bin/podman rm -v -f -i scrap
ExecStopPost=-/usr/bin/podman rm -v -f -i scrap
Type=notify
NotifyAccess=all
KillMode=mixed
Delegate=yes
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
SyslogIdentifier=%N

[Install]
WantedBy=default.target
