   "table",
   "queue_state",
   "CREATE TABLE queue_state ( id INTEGER PRIMARY KEY CHECK (id = 1), paused_until TEXT, -- NULL: running reason TEXT CHECK (reason IN ('auth', 'credit', 'outage', 'budget')), outages INTEGER NOT NULL DEFAULT 0, -- consecutive outage errors: backoff exponent notified_at TEXT, -- this pause has been announced updated_at TEXT NOT NULL )"
  ],
  "related": [
   "table",
   "related",
   "CREATE TABLE related ( page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, other_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, rank INTEGER NOT NULL, PRIMARY KEY (page_id, other_id) )"
  ],
  "related_by_other": [
   "index",
   "related",
   "CREATE INDEX related_by_other ON related(other_id)"
  ],
  "tag": [
   "table",
   "tag",
   "CREATE TABLE tag ( page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, tag TEXT NOT NULL CHECK (tag = lower(tag) AND length(tag) BETWEEN 1 AND 64), PRIMARY KEY (page_id, tag) )"
  ],
  "tag_by_name": [
   "index",
   "tag",
   "CREATE INDEX tag_by_name ON tag(tag)"
  ],
  "topic": [
   "table",
   "topic",
   "CREATE TABLE topic ( page_id TEXT PRIMARY KEY REFERENCES page(id) ON DELETE CASCADE, key TEXT NOT NULL UNIQUE CHECK (length(key) > 0), created_at TEXT NOT NULL )"
  ],
  "topic_run": [
   "table",
   "topic_run",
   "CREATE TABLE topic_run ( id INTEGER PRIMARY KEY, model TEXT NOT NULL, served_model TEXT, prompt_version TEXT NOT NULL, request TEXT NOT NULL CHECK (json_valid(request)), response TEXT CHECK (json_valid(response)), output TEXT CHECK (json_valid(output)), usage TEXT CHECK (json_valid(usage)), cost_microusd INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'running' CHECK (status IN ('running', 'ok', 'invalid', 'refused', 'error')), error_class TEXT, error TEXT, started_at TEXT NOT NULL, finished_at TEXT )"
  ],
  "topic_run_by_started": [
   "index",
   "topic_run",
   "CREATE INDEX topic_run_by_started ON topic_run(started_at)"
  ],
  "topic_source": [
   "table",
   "topic_source",
   "CREATE TABLE topic_source ( topic_id TEXT NOT NULL REFERENCES topic(page_id) ON DELETE CASCADE, page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, added_by TEXT NOT NULL, added_at TEXT NOT NULL, excluded INTEGER NOT NULL DEFAULT 0 CHECK (excluded IN (0, 1)), changed_at TEXT NOT NULL, PRIMARY KEY (topic_id, page_id) )"
  ],
  "topic_source_by_page": [
   "index",
   "topic_source",
   "CREATE INDEX topic_source_by_page ON topic_source(page_id)"
  ],
  "writeup": [
   "table",
   "writeup",
   "CREATE TABLE writeup ( page_id TEXT PRIMARY KEY REFERENCES page(id) ON DELETE CASCADE, producer TEXT NOT NULL, run_id INTEGER REFERENCES enrich_run(id), prompt_version TEXT NOT NULL, summary TEXT NOT NULL DEFAULT '', text TEXT NOT NULL, guidance TEXT, created_at TEXT NOT NULL )"
  ],
  "writeup_by_run": [
   "index",
   "writeup",
   "CREATE INDEX writeup_by_run ON writeup(run_id)"
  ],
  "writeup_guidance": [
   "table",
   "writeup_guidance",
   "CREATE TABLE writeup_guidance ( page_id TEXT PRIMARY KEY REFERENCES page(id) ON DELETE CASCADE, text TEXT NOT NULL, author TEXT NOT NULL, updated_at TEXT NOT NULL )"
  ]
 },
