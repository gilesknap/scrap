# scrap-public's web server: the public site, read only, GET and HEAD only.
# The entrypoint (`scrap-public web`) fills in the @...@ values and writes the result
# to /tmp/nginx.conf: the root filesystem is read only.
#
# The root is /site/www, which holds only the units' symlinks. The receiver's own
# folders (/site/units, /site/staging) are outside it, and its API (/v1/...) is
# a different port and process, so neither is reachable here.

worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    autoindex off;
    sendfile on;
    tcp_nopush on;
    access_log /dev/stdout;
    client_max_body_size 1k;

    client_body_temp_path /tmp/nginx-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    # The types of what units may hold (receiver.py's member_allowed: each kind
    # of unit has its own list); anything else is default_type
    types {
        text/html html;
        text/css css;
        text/javascript js mjs;
        application/json json;
        application/wasm wasm;
        text/plain txt;
        text/markdown md;
        application/pdf pdf;
        text/csv csv;
        application/zip zip;
        application/epub+zip epub;
        application/vnd.openxmlformats-officedocument.wordprocessingml.document docx;
        application/vnd.openxmlformats-officedocument.spreadsheetml.sheet xlsx;
        application/vnd.openxmlformats-officedocument.presentationml.presentation pptx;
        application/vnd.oasis.opendocument.text odt;
        application/vnd.oasis.opendocument.spreadsheet ods;
        application/vnd.oasis.opendocument.presentation odp;
        image/png png;
        image/jpeg jpg jpeg;
        image/gif gif;
        image/webp webp;
        image/avif avif;
        image/svg+xml svg;
        image/x-icon ico;
        font/woff woff;
        font/woff2 woff2;
        font/ttf ttf;
    }
    # Pagefind's index files (pagefind, pf_*) and bin
    default_type application/octet-stream;
    # Not image/svg+xml: an SVG is XML (UTF-8 unless it says otherwise), and
    # excalidraw.com opens a drawing's SVG only as exactly "image/svg+xml" (#526:
    # its loadFromBlob compares the Blob's type whole, so a charset makes it JSON)
    charset utf-8;
    charset_types text/css text/javascript text/plain text/markdown text/csv application/json;

    # The CSP, by path (docs/reference/public-site.md). A page's images and
    # attachments follow ADR 42's rule for stored files: sandboxed and loading
    # nothing, but a PDF keeps sandbox alone, as a browser's PDF viewer needs more.
    # Pages and tag pages have no <style> element (their CSS is /assets/page.css;
    # KaTeX's inline style attributes only) and run only the site's own scripts
    # ('self'): the one a page may name is /assets/prefs.js, the theme and column
    # width (#519; scrap's check refuses any other). Home also runs Pagefind's.
    # The site's icon (/assets/icon.svg, #527) is an SVG as a page's images are.
    map $uri $scrap_csp {
        "~*^/p/[a-z0-9-]+/file-[^/]*\.pdf$" "sandbox";
        "~^/p/[a-z0-9-]+/(img|file)-" "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:";
        "~*^/assets/[^/]*\.svg$" "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:";
        "~^/[pt]/" "default-src 'none'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
        default "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
    }

    # A page's SVG images may be fetched by excalidraw.com, which opens a published
    # drawing from its "Open in Excalidraw" link (#520: #url=<the SVG's address>, read
    # in the reader's browser). The pages are public, so a fixed origin: no Vary. Every
    # other answer has no Access-Control-Allow-Origin (nginx leaves out an empty one)
    map $uri $scrap_cors {
        "~^/p/[a-z0-9-]+/img-[^/]*\.svg$" "https://excalidraw.com";
        default "";
    }

    # HTML is checked each time, so a republished page shows at once; files for 5 min.
    # The site's own CSS and script (/assets/page.css, katex.css, prefs.js) are at fixed
    # addresses that every page names, so they are checked each time too (#534): a
    # browser revalidates with the ETag (a 304 when nothing changed) and never pairs a
    # new release's HTML with the last one's stylesheet. no-cache, not no-store, so
    # Cloudflare and browsers still keep a copy. KaTeX's fonts and the icons stay 5 min
    map $uri $scrap_file_cache {
        "~^/assets/[^/]*\.(css|js)$" "no-cache";
        default "public, max-age=300";
    }
    map $sent_http_content_type $scrap_cache {
        ~^text/html "no-cache";
        default $scrap_file_cache;
    }

    server {
        listen 8080 default_server;
        root /site/www;

        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        # One set of headers for every answer (no location adds its own, so all
        # inherit these: a location's add_header would replace them all)
        add_header Content-Security-Policy $scrap_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Robots-Tag "@X_ROBOTS_TAG@" always;
        add_header Cache-Control $scrap_cache always;
        add_header Access-Control-Allow-Origin $scrap_cors always;

        error_page 404 /404.html;
        location = /404.html {
            internal;
            root /site/www/home;
        }

        location = /robots.txt {
            default_type text/plain;
            return 200 "@ROBOTS_TXT@";
        }

        location = / {
            try_files /home/index.html =404;
        }
        location = /tags {
            try_files /home/tags.html =404;
        }
        # What a browser asks for on its own where a page names no icon (an image or
        # a PDF opened alone): the site's, scrap's icon (#527). A relative Location,
        # so it holds behind the TLS proxy
        location = /favicon.ico {
            absolute_redirect off;
            return 302 /assets/icon.svg;
        }

        # A page or a tag page: /p/<slug> and /t/<key>, with or without the slash
        location ~ "^/(p/[a-z0-9-]{1,120}|t/[a-z0-9-]{1,80})/?$" {
            try_files /$1/index.html =404;
        }
        # A file of one: each segment as the receiver allows, at most 4
        location ~ "^/(p/[a-z0-9-]{1,120}|t/[a-z0-9-]{1,80})/((?:[A-Za-z0-9_][A-Za-z0-9._-]{0,99}/){0,3}[A-Za-z0-9_][A-Za-z0-9._-]{0,99})$" {
            try_files /$1/$2 =404;
        }
        # The search index, and the shared assets (KaTeX's CSS and fonts)
        location ~ "^/(pagefind|assets)/((?:[A-Za-z0-9_][A-Za-z0-9._-]{0,99}/){0,3}[A-Za-z0-9_][A-Za-z0-9._-]{0,99})$" {
            try_files /$1/$2 =404;
        }

        # Everything else, the rest of the top level included: /home/..., /v1/...,
        # /units/..., dotfiles
        location / {
            return 404;
        }
    }
}
