 "objects": {
  "blob": [
   "table",
   "blob",
   "CREATE TABLE blob ( sha256 TEXT PRIMARY KEY, mime TEXT NOT NULL, size INTEGER NOT NULL, created_at TEXT NOT NULL )"
  ],
  "capture": [
   "table",
   "capture",
   "CREATE TABLE capture ( id TEXT PRIMARY KEY, -- ULID minted by the client: the retry key kind TEXT NOT NULL CHECK (kind IN ('photo', 'note', 'url', 'file')), text TEXT, url TEXT, source TEXT NOT NULL, -- 'pwa', 'share', 'mcp' author TEXT NOT NULL, created_at TEXT NOT NULL, -- on the device received_at TEXT NOT NULL, -- on the server page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE )"
  ],
  "capture_blob": [
   "table",
   "capture_blob",
   "CREATE TABLE capture_blob ( capture_id TEXT NOT NULL REFERENCES capture(id) ON DELETE CASCADE, ord INTEGER NOT NULL, sha256 TEXT NOT NULL REFERENCES blob(sha256), filename TEXT, PRIMARY KEY (capture_id, ord) )"
  ],
  "capture_by_page": [
   "index",
   "capture",
   "CREATE INDEX capture_by_page ON capture(page_id)"
  ],
  "chunk": [
   "table",
   "chunk",
   "CREATE TABLE chunk ( id INTEGER PRIMARY KEY, page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, ord INTEGER NOT NULL, text TEXT NOT NULL , derived_id INTEGER REFERENCES derived(id) ON DELETE CASCADE, title TEXT NOT NULL DEFAULT '', tags TEXT NOT NULL DEFAULT '', summary TEXT NOT NULL DEFAULT '')"
  ],
  "chunk_ad": [
   "trigger",
   "chunk",
   "CREATE TRIGGER chunk_ad AFTER DELETE ON chunk BEGIN INSERT INTO chunk_fts(chunk_fts, rowid, title, tags, summary, text) VALUES ('delete', old.id, old.title, old.tags, old.summary, old.text); END"
  ],
  "chunk_ai": [
   "trigger",
   "chunk",
   "CREATE TRIGGER chunk_ai AFTER INSERT ON chunk BEGIN INSERT INTO chunk_fts(rowid, title, tags, summary, text) VALUES (new.id, new.title, new.tags, new.summary, new.text); END"
  ],
  "chunk_bu": [
   "trigger",
   "chunk",
   "CREATE TRIGGER chunk_bu BEFORE UPDATE ON chunk BEGIN SELECT RAISE(ABORT, 'chunks are immutable: delete and insert'); END"
  ],
  "chunk_by_derived": [
   "index",
   "chunk",
   "CREATE INDEX chunk_by_derived ON chunk(derived_id)"
  ],
  "chunk_by_page": [
   "index",
   "chunk",
   "CREATE INDEX chunk_by_page ON chunk(page_id)"
  ],
  "chunk_fts": [
   "table",
   "chunk_fts",
   "CREATE VIRTUAL TABLE chunk_fts USING fts5( title, tags, summary, text, content='chunk', content_rowid='id', tokenize='porter unicode61' )"
  ],
  "derived": [
   "table",
   "derived",
   "CREATE TABLE derived ( id INTEGER PRIMARY KEY, capture_id TEXT NOT NULL REFERENCES capture(id) ON DELETE CASCADE, source_sha256 TEXT NOT NULL DEFAULT '', kind TEXT NOT NULL CHECK (kind IN ('ocr', 'description', 'summary', 'fetched', 'excalidraw')), version INTEGER NOT NULL CHECK (version >= 1), producer TEXT NOT NULL, -- model id, or 'human' run_id INTEGER REFERENCES model_run(id), -- the call that made it; NULL if human author TEXT, -- of a human version text TEXT, -- indexed while current data TEXT CHECK (json_valid(data)), -- excalidraw: {format: ..., elements: ...} superseded_at TEXT, -- NULL: the current version created_at TEXT NOT NULL, UNIQUE (capture_id, source_sha256, kind, version) )"
  ],
  "derived_by_run": [
   "index",
   "derived",
   "CREATE INDEX derived_by_run ON derived(run_id)"
  ],
  "derived_current": [
   "index",
   "derived",
   "CREATE UNIQUE INDEX derived_current ON derived(capture_id, source_sha256, kind) WHERE superseded_at IS NULL"
  ],
  "derived_immutable": [
   "trigger",
   "derived",
   "CREATE TRIGGER derived_immutable BEFORE UPDATE OF capture_id, source_sha256, kind, version, producer, run_id, author, text, data, created_at ON derived BEGIN SELECT RAISE(ABORT, 'derived versions are immutable: insert a new version'); END"
  ],
  "derived_index": [
   "trigger",
   "derived",
   "CREATE TRIGGER derived_index AFTER INSERT ON derived WHEN new.superseded_at IS NULL AND coalesce(new.text, '') <> '' BEGIN INSERT INTO chunk (page_id, derived_id, ord, text) SELECT page_id, new.id, 0, new.text FROM capture WHERE id = new.capture_id; END"
  ],
  "derived_once": [
   "trigger",
   "derived",
   "CREATE TRIGGER derived_once BEFORE UPDATE OF superseded_at ON derived WHEN old.superseded_at IS NOT NULL BEGIN SELECT RAISE(ABORT, 'a superseded version stays superseded: insert a copy to restore it'); END"
  ],
  "derived_supersede": [
   "trigger",
   "derived",
   "CREATE TRIGGER derived_supersede BEFORE INSERT ON derived WHEN new.superseded_at IS NULL BEGIN UPDATE derived SET superseded_at = new.created_at WHERE capture_id = new.capture_id AND source_sha256 = new.source_sha256 AND kind = new.kind AND superseded_at IS NULL; END"
  ],
  "derived_unindex": [
   "trigger",
   "derived",
   "CREATE TRIGGER derived_unindex AFTER UPDATE OF superseded_at ON derived WHEN new.superseded_at IS NOT NULL BEGIN DELETE FROM chunk WHERE derived_id = new.id; END"
  ],
  "enrich_job": [
   "table",
   "enrich_job",
   "CREATE TABLE enrich_job ( id INTEGER PRIMARY KEY, page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, reason TEXT NOT NULL CHECK (reason IN ('capture', 'save', 'ask', 'backfill', 'related', 'writeup', 'topic')), state TEXT NOT NULL DEFAULT 'queued' CHECK (state IN ('queued', 'running', 'done', 'dead')), failures INTEGER NOT NULL DEFAULT 0, run_after TEXT NOT NULL, last_error TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL )"
  ],
  "enrich_job_one_queued": [
   "index",
   "enrich_job",
   "CREATE UNIQUE INDEX enrich_job_one_queued ON enrich_job(page_id) WHERE state = 'queued'"
  ],
  "enrich_job_ready": [
   "index",
   "enrich_job",
   "CREATE INDEX enrich_job_ready ON enrich_job(state, run_after)"
  ],
  "enrich_run": [
   "table",
   "enrich_run",
   "CREATE TABLE enrich_run ( id INTEGER PRIMARY KEY, page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, job_id INTEGER REFERENCES enrich_job(id) ON DELETE SET NULL, model TEXT NOT NULL, served_model TEXT, prompt_version TEXT NOT NULL, request TEXT NOT NULL CHECK (json_valid(request)), response TEXT CHECK (json_valid(response)), output TEXT CHECK (json_valid(output)), usage TEXT CHECK (json_valid(usage)), cost_microusd INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'running' CHECK (status IN ('running', 'ok', 'invalid', 'refused', 'error')), error_class TEXT, error TEXT, started_at TEXT NOT NULL, finished_at TEXT )"
  ],
  "enrich_run_by_page": [
   "index",
   "enrich_run",
   "CREATE INDEX enrich_run_by_page ON enrich_run(page_id)"
  ],
  "enrich_run_by_started": [
   "index",
   "enrich_run",
   "CREATE INDEX enrich_run_by_started ON enrich_run(started_at)"
  ],
  "enrichment": [
   "table",
   "enrichment",
   "CREATE TABLE enrichment ( page_id TEXT PRIMARY KEY REFERENCES page(id) ON DELETE CASCADE, run_id INTEGER REFERENCES enrich_run(id), producer TEXT NOT NULL, summary TEXT NOT NULL DEFAULT '', source TEXT, source_title TEXT, updated_at TEXT NOT NULL )"
  ],
  "job": [
   "table",
   "job",
   "CREATE TABLE job ( id INTEGER PRIMARY KEY, kind TEXT NOT NULL CHECK (kind IN ('ingest', 'refine')), capture_id TEXT NOT NULL REFERENCES capture(id) ON DELETE CASCADE, source_sha256 TEXT NOT NULL, -- the photo state TEXT NOT NULL DEFAULT 'queued' CHECK (state IN ('queued', 'running', 'done', 'dead')), failures INTEGER NOT NULL DEFAULT 0, -- charged failures (all but pauses): dead at 3 options TEXT NOT NULL DEFAULT '{}' CHECK (json_type(options) = 'object'), run_after TEXT NOT NULL, last_error TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL )"
  ],
  "job_by_capture": [
   "index",
   "job",
   "CREATE INDEX job_by_capture ON job(capture_id)"
  ],
  "job_one_active": [
   "index",
   "job",
   "CREATE UNIQUE INDEX job_one_active ON job(kind, capture_id, source_sha256) WHERE state IN ('queued', 'running')"
  ],
  "job_ready": [
   "index",
   "job",
   "CREATE INDEX job_ready ON job(state, run_after)"
  ],
  "model_run": [
   "table",
   "model_run",
   "CREATE TABLE model_run ( id INTEGER PRIMARY KEY, capture_id TEXT NOT NULL REFERENCES capture(id) ON DELETE CASCADE, source_sha256 TEXT NOT NULL, job_id INTEGER REFERENCES job(id) ON DELETE SET NULL, parent_id INTEGER REFERENCES model_run(id), -- the turn this one continues (M4) purpose TEXT NOT NULL CHECK (purpose IN ('ingest', 'refine', 'discuss')), model TEXT NOT NULL, -- requested served_model TEXT, prompt_version TEXT NOT NULL, sent_sha256 TEXT REFERENCES blob(sha256), -- the JPEG actually sent, kept for replay image_width INTEGER, -- its pixels: the drawing's frame image_height INTEGER, request TEXT NOT NULL CHECK (json_valid(request)), response TEXT CHECK (json_valid(response)), -- content blocks as returned output TEXT CHECK (json_valid(output)), -- the sanitised result, with warnings usage TEXT CHECK (json_valid(usage)), cost_microusd INTEGER NOT NULL DEFAULT 0, -- from usage and a price table status TEXT NOT NULL DEFAULT 'running' CHECK (status IN ('running', 'ok', 'invalid', 'refused', 'error')), error_class TEXT CHECK (error_class IN ('credit', 'auth', 'outage', 'budget', 'timeout', 'invalid', 'content', 'image', 'internal', 'crashed')), error TEXT, started_at TEXT NOT NULL, finished_at TEXT )"
  ],
  "model_run_by_source": [
   "index",
   "model_run",
   "CREATE INDEX model_run_by_source ON model_run(capture_id, source_sha256)"
  ],
  "model_run_by_started": [
   "index",
   "model_run",
   "CREATE INDEX model_run_by_started ON model_run(started_at)"
  ],
  "model_tag": [
   "table",
   "model_tag",
   "CREATE TABLE model_tag ( page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, tag TEXT NOT NULL, state TEXT NOT NULL CHECK (state IN ('on', 'off')), producer TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY (page_id, tag) )"
  ],
  "page": [
   "table",
   "page",
   "CREATE TABLE page ( id TEXT PRIMARY KEY, -- ULID slug TEXT NOT NULL UNIQUE, title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '', -- Markdown kind TEXT NOT NULL DEFAULT 'note' CHECK (kind IN ('note', 'todo', 'consume', 'whiteboard', 'document')), kind_fixed INTEGER NOT NULL DEFAULT 0 CHECK (kind_fixed IN (0, 1)), -- 1: the user chose it fields TEXT NOT NULL DEFAULT '{}' CHECK (json_type(fields) = 'object'), -- flat created_at TEXT NOT NULL, updated_at TEXT NOT NULL, deleted_at TEXT -- set: in the trash , task_done INTEGER NOT NULL DEFAULT 0, task_total INTEGER NOT NULL DEFAULT 0, made_by TEXT NOT NULL DEFAULT 'human' CHECK (made_by IN ('human', 'claude', 'topic', 'gc')), public INTEGER NOT NULL DEFAULT 0 CHECK (public IN (0, 1)))"
  ],
  "page_by_kind": [
   "index",
   "page",
   "CREATE INDEX page_by_kind ON page(kind)"
  ],
  "page_by_updated": [
   "index",
   "page",
   "CREATE INDEX page_by_updated ON page(updated_at)"
  ],
  "page_made_by_fixed": [
   "trigger",
   "page",
   "CREATE TRIGGER page_made_by_fixed BEFORE UPDATE OF made_by ON page WHEN new.made_by IS NOT old.made_by BEGIN SELECT RAISE(ABORT, 'made_by is set when a page is made and never changed'); END"
  ],
  "page_meta_rev": [
   "table",
   "page_meta_rev",
   "CREATE TABLE page_meta_rev ( id INTEGER PRIMARY KEY AUTOINCREMENT, page_id TEXT NOT NULL REFERENCES page(id) ON DELETE CASCADE, author TEXT NOT NULL, source TEXT NOT NULL CHECK (source IN ('web', 'mcp')), kind_before TEXT NOT NULL, kind_after TEXT NOT NULL, fixed_before INTEGER NOT NULL CHECK (fixed_before IN (0, 1)), fixed_after INTEGER NOT NULL CHECK (fixed_after IN (0, 1)), tags_before TEXT NOT NULL CHECK (json_type(tags_before) = 'array'), tags_after TEXT NOT NULL CHECK (json_type(tags_after) = 'array'), fields_added TEXT NOT NULL DEFAULT '{}' CHECK (json_type(fields_added) = 'object'), reverts INTEGER REFERENCES page_meta_rev(id), batch_id TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, fields_was TEXT NOT NULL DEFAULT '{}' CHECK (json_type(fields_was) = 'object'), public_before INTEGER NOT NULL DEFAULT 0 CHECK (public_before IN (0, 1)), public_after INTEGER NOT NULL DEFAULT 0 CHECK (public_after IN (0, 1)))"
  ],
  "page_meta_rev_by_batch": [
